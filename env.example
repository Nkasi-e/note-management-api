# Server Configuration
APP_HOST=127.0.0.1
APP_PORT=3001

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/note_task_db
DB_MAX_CONNECTIONS=100
DB_CONNECTION_TIMEOUT_SECS=30

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ISSUER=note-task-api
JWT_AUDIENCE=note-clients
JWT_EXP_MINUTES=60

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL_SECS=300

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=noreply@yourdomain.com

# Logging Configuration
RUST_LOG=info
LOG_FORMAT=json

# File Storage Configuration
# Backend options: "local", "s3", "gcs", "cloudinary", "azure"
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt,zip
SERVE_FILES=true

# AWS S3 Configuration (only if STORAGE_BACKEND=s3)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_CDN_URL=https://d123456.cloudfront.net  # Optional CloudFront URL

# GCP Cloud Storage Configuration (only if STORAGE_BACKEND=gcs)
# GCP_BUCKET=your-bucket-name
# GCP_CDN_URL=https://storage.googleapis.com/your-bucket  # Optional
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Cloudinary Configuration (only if STORAGE_BACKEND=cloudinary)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Azure Blob Storage Configuration (only if STORAGE_BACKEND=azure)
# AZURE_ACCOUNT_NAME=your-storage-account-name
# AZURE_ACCOUNT_KEY=your-access-key
# AZURE_CONTAINER=your-container-name
# AZURE_CDN_URL=https://your-cdn.azureedge.net  # Optional Azure CDN URL
